# VOZ CABALLA · plantilla de variables de entorno
# Copia este archivo con el nombre .env (sin .example) y rellena tus valores.
# El archivo .env NO se sube a GitHub.

# Supabase > Project Settings > API (o la pantalla «Connect»)
PUBLIC_SUPABASE_URL=https://TU-REFERENCIA.supabase.co
PUBLIC_SUPABASE_KEY=tu-clave-publica

# Cloudflare Turnstile. Esta es la clave de PRUEBA (siempre pasa); sirve solo para desarrollar.
# Antes de lanzar, se sustituye por la clave real de tu widget.
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
