---
/**
 * VOZ CABALLA · components/Counters.astro
 * Los dos contadores: días transcurridos y voces (testimonios publicados).
 * Se coloca siempre dentro de la cabecera.
 */
import { diasTranscurridos, etiquetaDias, etiquetaVoces } from '../lib/contadores';

interface Props {
  variant: 'header';
  /** Testimonios publicados (si la página lo conoce). En páginas estáticas se actualiza en el navegador. */
  voces?: number;
}
const { variant, voces = 0 } = Astro.props;

const dias = diasTranscurridos();
---

<div class={`counters counters--${variant}`}>
  <div class="counter counter--days">
    <span class="counter__num" data-counter-days>{dias}</span>
    <span class="counter__label" data-counter-days-label>{etiquetaDias(dias)}</span>
  </div>
  <span class="counters__divider" aria-hidden="true"></span>
  <div class="counter counter--voices">
    <span class="counter__num" data-counter-voices>{voces}</span>
    <span class="counter__label" data-counter-voices-label>{etiquetaVoces(voces)}</span>
  </div>
</div>
