---
/**
 * VOZ CABALLA · components/Header.astro
 * Cabecera de Exprésate y Testimonios: botones de navegación, logotipo y contadores.
 * Se encoge al hacer scroll (ver styles/header.css y scripts/header-scroll.ts).
 */
import Counters from './Counters.astro';

interface Props {
  current: 'expresate' | 'testimonios';
}
const { current } = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <nav class="site-header__nav" aria-label="Principal">
      <a
        href="/expresate"
        class:list={['nav-link', { 'is-active': current === 'expresate' }]}
        aria-current={current === 'expresate' ? 'page' : undefined}>Exprésate</a
      >
      <a
        href="/testimonios"
        class:list={['nav-link', { 'is-active': current === 'testimonios' }]}
        aria-current={current === 'testimonios' ? 'page' : undefined}>Testimonios</a
      >
    </nav>

    <a class="site-header__logo" href="/" aria-label="VOZ CABALLA, ir al inicio">
      <img src="/logo.svg" alt="VOZ CABALLA" width="623" height="96" />
    </a>

    <Counters variant="header" />
  </div>
</header>
<div class="site-header-spacer" aria-hidden="true"></div>

<script>
  import '../scripts/header-scroll';
</script>
