---
/**
 * VOZ CABALLA · pages/index.astro  (HOME)
 * Logotipo, contadores, mensaje del proyecto, aviso de respeto y un único botón.
 */
export const prerender = true; // página estática: se genera una sola vez
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Voz Caballa | Testimonios e historias ciudadanas de Ceuta"
  description="Voz Caballa es un espacio ciudadano para escuchar, reunir y preservar testimonios e historias de personas de Ceuta. Detrás de cada cifra hay una historia."
  ogImage="https://vozcaballa.com/og-default.png"
>
  <Header current="home" />
  <main class="home">
    <div class="home__column">
      <section class="home__card-wrap" aria-labelledby="home-titulo">
        <p class="home__pill">¿Viviste los acontecimientos?</p>
        <div class="home__card">
          <h1 class="home__card-title" id="home-titulo">TU HISTORIA IMPORTA</h1>
          <div class="home__card-body">
            <p>
              Voz Caballa es un espacio ciudadano para escuchar, reunir y preservar los testimonios
              y las historias de personas de Ceuta.
            </p>
            <p>Porque detrás de cada cifra hay una historia.</p>
          </div>
        </div>
      </section>

      <p class="home__respect">
        Cada testimonio es una persona real. Te pedimos respeto al leer y al compartir. Aquí no caben
        los mensajes racistas, machistas, homófobos ni de odio hacia ninguna persona o colectivo.
      </p>

      <a class="btn-rojo" href="/expresate">Comenzar con respeto</a>
    </div>
  </main>
  <Footer />
</Layout>
