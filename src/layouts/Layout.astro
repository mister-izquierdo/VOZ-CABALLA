---
/**
 * VOZ CABALLA · layouts/Layout.astro
 * Estructura común de todas las páginas: <head>, tipografía, estilos y contadores.
 */
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/counters.css';
import '../styles/header.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/form.css';
import '../styles/testimonios.css';
import '../styles/admin.css';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  /** Dirección completa de la página (para buscadores y redes). */
  canonical?: string;
  /** Dirección completa de la imagen que se ve al compartir el enlace. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** true = que los buscadores no la indexen. */
  noindex?: boolean;
}

const {
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false,
  title = 'VOZ CABALLA',
  description = 'Un espacio para preservar las historias de los ceutíes y que sus testimonios sean escuchados. Detrás de cada cifra hay una historia.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="VOZ CABALLA" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <!-- Icono del avión de papel: se define una vez y se reutiliza en todas las fichas -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="icono-avion" viewBox="0 0 96.40 88.10">
        <path fill-rule="evenodd" fill="currentColor" d="M10.10 3.40 L7.40 5.10 L4.90 7.70 L3.10 10.80 L2.50 12.60 L2.00 15.70 L2.00 18.40 L2.80 21.90 L4.10 24.80 L6.20 27.80 L8.10 30.10 L10.90 32.90 L16.70 38.00 L22.00 43.40 L24.90 47.50 L26.90 51.60 L28.10 55.20 L29.30 60.40 L30.60 67.90 L31.40 71.30 L32.40 74.40 L34.30 78.40 L36.50 81.40 L38.20 82.90 L39.80 84.00 L42.30 85.20 L45.40 86.00 L50.10 86.00 L52.70 85.30 L55.20 84.10 L57.00 82.70 L58.30 81.40 L60.50 78.20 L76.30 52.00 L83.50 40.40 L91.90 26.20 L93.50 22.40 L94.40 17.90 L94.20 14.10 L93.40 11.30 L92.60 9.70 L91.40 8.00 L90.20 6.70 L87.10 4.50 L84.80 3.50 L80.50 2.40 L78.10 2.20 L50.70 2.00 L16.00 2.10 L12.40 2.50ZM12.80 10.70 L14.40 10.10 L16.50 9.70 L23.70 9.50 L55.20 9.50 L80.30 9.80 L81.70 10.00 L83.00 10.50 L84.40 11.60 L85.70 13.30 L86.70 15.90 L86.70 17.40 L85.90 19.60 L68.90 48.40 L59.40 64.10 L58.20 65.80 L55.20 71.00 L52.30 75.10 L49.90 77.10 L48.90 77.60 L47.60 77.90 L45.00 77.60 L43.10 76.60 L41.70 75.30 L41.00 74.30 L39.80 70.90 L39.50 69.20 L38.30 65.20 L37.60 61.70 L36.50 57.80 L35.50 52.70 L34.80 50.20 L34.60 47.90 L35.10 46.80 L36.90 45.40 L52.30 36.90 L57.70 33.70 L64.30 30.10 L65.70 29.10 L66.40 28.30 L66.80 27.40 L66.70 25.60 L66.00 23.90 L65.00 22.80 L63.70 22.10 L62.60 22.00 L60.90 22.60 L54.90 26.10 L51.50 27.80 L33.30 38.30 L31.10 39.30 L30.10 39.30 L29.40 39.00 L28.00 37.90 L23.50 33.60 L11.80 21.80 L10.40 20.00 L10.00 19.20 L9.50 17.30 L9.60 14.90 L10.00 13.80 L10.90 12.30 L11.90 11.30Z" />
      </symbol>
    </svg>
    <slot />
    <CookieConsent />
    <script>
      import '../scripts/counters';
      import '../scripts/compartir';
    </script>
  </body>
</html>
